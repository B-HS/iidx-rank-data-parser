{
    "name": "iidx-data-parser",
    "description": "beatmania IIDX e-amusement DJ data parser for iidx-rank",
    "version": "0.1.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "IIDX Data Parser",
        "default_popup": "popup/index.html"
    },
    "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "downloads"],
    "host_permissions": ["https://p.eagate.573.jp/*"],
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://p.eagate.573.jp/game/2dx/*"],
            "js": ["content-script.js"],
            "run_at": "document_idle"
        }
    ],
    "minimum_chrome_version": "116"
}
