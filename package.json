{
    "name": "iidx-data-parser",
    "module": "src/popup/index.tsx",
    "version": "1.0.0",
    "scripts": {
        "build": "bun run config/build.ts",
        "dev": "bun run config/watch.ts --dir=src,public",
        "pack": "bun run config/pack.ts",
        "css": "postcss",
        "icon": "bun run scripts/generate-icon.mjs",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"config/*.ts\" \"scripts/*.mjs\" \"docs/*.md\" \"*.{json,js,ts,md}\""
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.5.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.5",
        "@types/bun": "latest",
        "@types/chrome": "^0.0.270",
        "@types/jsdom": "^21.1.7",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "adm-zip": "^0.5.15",
        "autoprefixer": "^10.4.20",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.41",
        "postcss-cli": "^11.0.0",
        "postcss-import": "^16.1.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^3.4.10",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.6.3"
    }
}
